# drainme configuration. Copy to .env and fill in. Every key is documented here (D67).
# Never put the seed itself in this file or in .env (D26).

# --- Deployment (read by compose.yaml) ---

# Token of drainme's own Cloudflare tunnel (D3, D56). Its public hostname points at http://drainme-app:8080.
DRAINME_TUNNEL_TOKEN=

# Host paths, relative to this directory. The ledger directory must exist and be owned by 65532:65532; the seed
# file holds the 64-hex Nano seed, mode 0400, owned by 65532 (D26, D69). Never put the seed itself in this file.
DRAINME_HOST_DATA=./data/drainme
DRAINME_SEED_HOST_FILE=./secrets/drainme_seed

# Container limits (D53, resized by D99). Each live viewer costs about 33 KB; 5,000 of them plus a click flood
# peaked at 306 MB in testing, so the app gets 512m with the Go runtime told to stay under 450MiB.
DRAINME_CPUS=0.5
DRAINME_MEMORY=512m
DRAINME_PIDS=128
DRAINME_GOMEMLIMIT=450MiB
# cloudflared proxies one connection per live viewer too; an estimate, so watch `docker stats` at launch.
DRAINME_TUNNEL_MEMORY=384m

# --- The service ---

# Outside a container only: compose fixes these to /data and /run/secrets/drainme_seed. The account used is
# index 0 of the seed (D85).
# DRAINME_DATA_DIR=/data
# DRAINME_SEED_FILE=/run/secrets/drainme_seed

# Nano RPC endpoints for reads and broadcast, comma-separated, tried in order (D5, D6, D103): each request goes
# to the first that answers, so the first carries nearly all the load. These and the work URLs are also the
# egress proxy's entire allow-list (D93): serve can reach nothing else.
# https only; plain http is accepted for loopback hosts (local test nodes).
# Probed 2026-10-03 with every call drainme makes; per-IP allowances are what each node reported then:
#   nanoslo.0x.no      all calls; 100,000 requests
#   rainstorm.city     all calls; 5,000
#   node.somenano.com  all calls but work (its work backend is gone); 5,000
#   rpc.nano.to        all calls but work (charges for it)
#   app.natrium.io     all calls but work
#   xno-rpc.berrypay   all calls; only 30 broadcasts, so it sits low here and first for work
#   bitrequest.app     no receivable (init-vault only) and no work
DRAINME_RPC_URLS=https://nanoslo.0x.no/proxy,https://rainstorm.city/api,https://node.somenano.com/proxy,https://rpc.nano.to,https://app.natrium.io/api,https://xno-rpc.berrypay.org/proxy,https://www.bitrequest.app:8020

# work_generate endpoints, comma-separated, tried in order (D7). Defaults to DRAINME_RPC_URLS when unset.
# Every returned work value is validated locally against the threshold below. Probed 2026-10-03 at the send
# threshold: berrypay about 1 s, nanoslo and rainstorm about 13 s. No other free endpoint answered.
# The last entry is this machine's own CPU (the work service, D104): it only works when all the others fail, and
# averages about a minute per payout on two cores. Plain http is allowed only for loopback and container names.
DRAINME_WORK_URLS=https://xno-rpc.berrypay.org/proxy,https://nanoslo.0x.no/proxy,https://rainstorm.city/api,http://drainme-work:7076

# How long one work request may take per endpoint (D104), separate from DRAINME_RPC_TIMEOUT because the local
# fallback takes minutes. A work server that hangs costs this once, then sits out for a minute.
DRAINME_WORK_TIMEOUT=3m

# Cores the local work service may use when it runs (D104). It has the lowest CPU weight, so other services on
# the host go first; THREADS should match CPUS.
DRAINME_WORK_CPUS=2
DRAINME_WORK_THREADS=2

# PoW thresholds as 16 hex digits. Values verified on 2026-10-03 against docs.nano.org and a live
# active_difficulty call (DECISIONS.md R1). Re-check before launch; they are deliberately not compiled in.
DRAINME_SEND_THRESHOLD=fffffff800000000
DRAINME_RECEIVE_THRESHOLD=fffffe0000000000

# The send threshold follows the network's own minimum upward when two nodes agree on it, checked hourly, but
# never past this ceiling (D104). The default is four times today's threshold.
DRAINME_SEND_THRESHOLD_MAX=fffffffe00000000

# Representative set on the hot wallet by `init-vault` (D8). Pick at funding time.
DRAINME_REPRESENTATIVE=

# Per-request timeout for RPC calls (Go duration). A node that fails sits out for a minute (D104).
DRAINME_RPC_TIMEOUT=10s

# Most addresses that can wait for a payout at once (F1). When full, /withdraw answers 503 and the balance
# stays credited; an address already waiting still merges new withdrawals into its place in line.
# D104 raised the default to 10,000; withdraw answers with an estimated wait.
DRAINME_QUEUE_MAX=10000

# Most addresses that can be owed money at once (D89). Each costs about 165 bytes of disk, so the default of
# 30,000,000 is about 5 GB. When full, a click for a NEW address answers 503; addresses already owed keep
# counting, and an address that withdraws frees its slot.
DRAINME_ADDRESS_MAX=30000000

# Most live streams (the page's GET /events) open at once (D34). Past it a viewer sees "stream full" and retries
# after 30-60 s; clicking is unaffected.
DRAINME_SSE_MAX=5000

# A balance with no click for this long is paid out to its own address by itself (D96), which also frees its
# slot under DRAINME_ADDRESS_MAX. Idle payouts wait for the queue to be empty and go at most one per 30 s, so a
# person never waits behind more than one. Go duration; 0 turns it off.
DRAINME_IDLE_AFTER=24h
